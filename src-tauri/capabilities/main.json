{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the local main window may use the explicitly listed application commands.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:window:allow-inner-size",
    "core:window:allow-scale-factor",
    "core:window:allow-set-size",
    "core:event:allow-unlisten",
    "allow-app-snapshot",
    "allow-model-download",
    "allow-model-cancel",
    "allow-refinement-download",
    "allow-refinement-cancel-setup",
    "allow-recording-start",
    "allow-recording-stop",
    "allow-recording-cancel",
    "allow-transcript-clear",
    "allow-transcript-copy",
    "allow-microphone-request",
    "allow-accessibility-request",
    "allow-settings-save",
    "allow-settings-reset",
    "allow-devices-refresh"
  ]
}
