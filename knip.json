{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/**/*.test.{ts,tsx}",
    "scripts/*.mjs",
    "*.config.{ts,mjs}",
    "scripts/*.ts",
    "tests/tooling/**/*.test.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.mjs",
    "*.config.{ts,mjs}",
    "scripts/**/*.ts",
    "tests/tooling/**/*.ts",
    "tests/fixtures/browser-fields/**/*.ts"
  ],
  "ignoreBinaries": ["gitleaks", "mkfifo"]
}
