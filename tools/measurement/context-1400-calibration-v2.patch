+//! Isolated calibration selector. This is not a production context policy.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ProfileAudioContext {
+    Reference,
+    Candidate1400,
+}
+#[derive(Debug, PartialEq, Eq)]
+pub enum ContextError<E> {
+    ModelContext,
+    PreparedFrames,
+    Decode(E),
+}
+#[derive(Debug)]
+pub struct ContextObservation {
+    pub selection: ProfileAudioContext,
+    pub desired_parameter: i32,
+    pub observed_model_context: i32,
+    pub model_verified: bool,
+    pub effective_context_derived: Option<i32>,
+    pub prepared_frames: Option<usize>,
+    pub full_attempted: bool,
+}
+impl ProfileAudioContext {
+    pub fn parse(value: &str) -> Option<Self> {
+        match value {
+            "reference" => Some(Self::Reference),
+            "candidate1400" => Some(Self::Candidate1400),
+            _ => None,
+        }
+    }
+    pub fn label(self) -> &'static str {
+        match self {
+            Self::Reference => "reference",
+            Self::Candidate1400 => "candidate1400",
+        }
+    }
+    pub fn parameter(self) -> i32 {
+        match self {
+            Self::Reference => 0,
+            Self::Candidate1400 => 1400,
+        }
+    }
+}
+impl ContextObservation {
+    pub fn new(selection: ProfileAudioContext, model: i32) -> Self {
+        Self {
+            selection,
+            desired_parameter: selection.parameter(),
+            observed_model_context: model,
+            model_verified: model == 1500,
+            effective_context_derived: if model == 1500 {
+                Some(if selection == ProfileAudioContext::Reference {
+                    1500
+                } else {
+                    1400
+                })
+            } else {
+                None
+            },
+            prepared_frames: None,
+            full_attempted: false,
+        }
+    }
+    pub(super) fn run<T, E>(
+        &mut self,
+        input: &[f32],
+        decode: impl FnOnce(&[f32], i32) -> Result<T, E>,
+    ) -> Result<T, ContextError<E>> {
+        self.prepared_frames = Some(input.len());
+        if !self.model_verified {
+            return Err(ContextError::ModelContext);
+        }
+        if self.selection == ProfileAudioContext::Candidate1400
+            && (input.is_empty() || input.len() > 320000)
+        {
+            return Err(ContextError::PreparedFrames);
+        }
+        decode(input, self.selection.parameter()).map_err(ContextError::Decode)
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn reference_and_candidate_dispatch_the_identical_pcm_once_with_only_the_selected_parameter()
+    -> Result<(), Box<dyn std::error::Error>> {
+        let input = [0.02, -0.03, 0.04];
+        for (selection, parameter, effective) in [
+            (ProfileAudioContext::Reference, 0, 1500),
+            (ProfileAudioContext::Candidate1400, 1400, 1400),
+        ] {
+            let mut record = ContextObservation::new(selection, 1500);
+            let mut calls = 0;
+            let output = record.run(&input, |pcm, p| {
+                calls += 1;
+                assert_eq!(pcm.as_ptr(), input.as_ptr());
+                assert_eq!(pcm, input);
+                assert_eq!(p, parameter);
+                Ok::<_, ()>("unchanged result")
+            });
+            assert_eq!(output, Ok("unchanged result"));
+            assert_eq!(calls, 1);
+            assert_eq!(record.effective_context_derived, Some(effective));
+            assert_eq!(record.prepared_frames, Some(3));
+            assert!(!record.full_attempted);
+        }
+        Ok(())
+    }
+
+    #[test]
+    fn candidate_rejects_wrong_model_and_overbound_prepared_pcm_before_decode() {
+        for model in [-1, 0, 1024, 1400, 1499, 1501] {
+            let mut record = ContextObservation::new(ProfileAudioContext::Candidate1400, model);
+            let mut called = false;
+            let result = record.run(&[0.02], |_, _| {
+                called = true;
+                Ok::<_, ()>(())
+            });
+            assert_eq!(result, Err(ContextError::ModelContext));
+            assert!(!called);
+            assert!(!record.model_verified);
+            assert_eq!(record.effective_context_derived, None);
+            assert!(!record.full_attempted);
+        }
+        for frames in [0, 320001] {
+            let mut record = ContextObservation::new(ProfileAudioContext::Candidate1400, 1500);
+            let mut called = false;
+            let result = record.run(&vec![0.02; frames], |_, _| {
+                called = true;
+                Ok::<_, ()>(())
+            });
+            assert_eq!(result, Err(ContextError::PreparedFrames));
+            assert!(!called);
+            assert_eq!(record.prepared_frames, Some(frames));
+            assert!(!record.full_attempted);
+        }
+        let mut edge = ContextObservation::new(ProfileAudioContext::Candidate1400, 1500);
+        assert_eq!(
+            edge.run(&vec![0.02; 320000], |_, p| Ok::<_, ()>(p)),
+            Ok(1400)
+        );
+    }
+    #[test]
+    fn decode_error_is_preserved_without_claiming_a_full_or_getter_read() {
+        let mut record = ContextObservation::new(ProfileAudioContext::Candidate1400, 1500);
+        let result = record.run(&[0.02], |_, _| Err::<(), _>("native failure"));
+        assert_eq!(result, Err(ContextError::Decode("native failure")));
+        assert!(!record.full_attempted);
+    }
+    #[test]
+    fn selectors_are_closed_and_case_sensitive() {
+        assert_eq!(
+            ProfileAudioContext::parse("reference"),
+            Some(ProfileAudioContext::Reference)
+        );
+        assert_eq!(
+            ProfileAudioContext::parse("candidate1400"),
+            Some(ProfileAudioContext::Candidate1400)
+        );
+        for other in [
+            "1400",
+            "1500",
+            "candidate1024",
+            "REFERENCE",
+            "",
+            "candidate1400 ",
+            "--candidate1400",
+        ] {
+            assert_eq!(ProfileAudioContext::parse(other), None);
+        }
+    }
+}
