+    #[test]
+    fn zero_marker_cannot_hide_future_prefix_audio() {
+        assert!(admission(320, Some(false), Some(0), 6400, Some(10), [(6400, 11)]).is_err());
+    }
+    #[test]
+    fn missing_role_cannot_masquerade_as_final_audio() {
+        assert!(admission(320, None, Some(320), 6400, Some(10), [(6400, 9)]).is_err());
+    }
+    #[test]
+    fn correct_marker_still_requires_actual_after_publication() {
+        assert!(admission(320, Some(false), Some(5120), 6400, Some(10), [(5120, 11)]).is_err());
+        assert!(admission(320, Some(false), Some(5120), 6400, Some(11), [(5120, 11)]).is_ok());
+        assert!(admission(6400, Some(true), Some(6400), 6400, Some(11), [(6400, 11)]).is_ok());
+    }
+    #[test]
+    fn prefix_guard_must_fit_fixture_and_checked_arithmetic() {
+        assert!(admission(6400, Some(false), Some(11200), 6400, Some(11), [(11200, 9)]).is_err());
+        assert!(admission(usize::MAX, Some(false), Some(0), usize::MAX, Some(11), []).is_err());
+        assert!(admission(6401, Some(true), Some(6401), 6400, Some(11), [(6401, 9)]).is_err());
+    }
+}
+/// Reconstruct the fixed producer guard independently of its trace marker.
+pub fn admission(
+    end: usize,
+    released: Option<bool>,
+    marker: Option<usize>,
+    fixture: usize,
+    submitted: Option<u128>,
+    publications: impl IntoIterator<Item = (usize, u128)>,
+) -> Result<(), &'static str> {
+    let submitted = submitted.ok_or("service-accepted job has no observed host submission")?;
+    if end == 0 || end > fixture {
+        return Err("job endpoint exceeds the bound prepared fixture");
+    }
+    let required = match released {
+        Some(true) => end,
+        Some(false) => end.checked_add(4800).ok_or("prefix guard overflow")?,
+        None => return Err("job submission role missing"),
+    };
+    if required > fixture || marker != Some(required) {
+        return Err(
+            "trace stable-frame marker differs from independently reconstructed role guard",
+        );
+    }
+    stable(required, submitted, publications)
+}
+
+#[cfg(test)]
+mod missing_submission_test {
+    use super::*;
+    #[test]
+    fn accepted_job_without_host_submission_cannot_bypass_admission() {
+        assert!(admission(320, Some(false), Some(5120), 6400, None, [(6400, 1)]).is_err());
+    }
+}
+
+/// Full-prefix Stop: revisions overlap at zero; only the released last job is final.
+pub fn prefix_coverage<'a>(
+    records: impl IntoIterator<Item = (&'a Identity, Option<bool>)>,
+    session: u64,
+    frames: usize,
+    candidate: bool,
+) -> Result<(), &'static str> {
+    let records = records.into_iter().take(602).collect::<Vec<_>>();
+    if records.is_empty()
+        || records.len() > 601
+        || (!candidate && records.len() != 1)
+        || (candidate && records.len() < 2)
+    {
+        return Err("full-prefix resource Stop did not exercise its selected mode");
+    }
+    let mut previous_job = 0;
+    let mut previous_cut = 0;
+    let generation = records[0].0.generation;
+    for (index, (record, released)) in records.iter().enumerate() {
+        let final_job = index + 1 == records.len();
+        if record.session != session
+            || record.generation != generation
+            || generation == 0
+            || record.job <= previous_job
+            || record.storage_start != 0
+            || record.timeline_start != 0
+            || record.storage_end != record.timeline_end
+            || record.frames != record.timeline_end
+            || record.frames == 0
+            || record.frames > frames
+            || *released != Some(final_job)
+            || (final_job && record.frames != frames)
+            || (!final_job && record.frames <= previous_cut)
+        {
+            return Err("full-prefix Stop has stale/order/role/range or final coverage mismatch");
+        }
+        previous_job = record.job;
+        previous_cut = record.frames;
+    }
+    Ok(())
+}
+#[cfg(test)]
+mod prefix_tests {
+    use super::*;
+    fn key(end: usize, job: u64) -> Identity {
+        Identity {
+            session: 9,
+            generation: 3,
+            job,
+            storage_start: 0,
+            storage_end: end,
+            timeline_start: 0,
+            timeline_end: end,
+            frames: end,
+            language: Some("de"),
+        }
+    }
+    #[test]
+    fn cumulative_revisions_cover_whole_final_without_append_or_disjoint_rule() {
+        let prefix = key(19200, 7);
+        let final_job = key(24000, 8);
+        assert!(
+            prefix_coverage(
+                [(&prefix, Some(false)), (&final_job, Some(true))],
+                9,
+                24000,
+                true
+            )
+            .is_ok()
+        );
+        assert!(prefix_coverage([(&final_job, Some(true))], 9, 24000, false).is_ok());
+        assert!(prefix_coverage([(&prefix, Some(false))], 9, 24000, true).is_err());
+        assert!(
+            prefix_coverage([(&prefix, Some(false)), (&final_job, None)], 9, 24000, true).is_err()
+        );
+    }
+}
+
+/// Validate the shape of an actual worker receipt without inventing preparation.
+pub fn reuse_shape(
+    outcome: &str,
+    prepared: Option<usize>,
+    hash: Option<&[u8; 32]>,
+    origin: Option<u64>,
+    invoked: bool,
+    native: bool,
+    job: u64,
+) -> Result<(), &'static str> {
+    if job == 0
+        || prepared.is_some() != hash.is_some()
+        || prepared.is_some_and(|n| !(16000..=4_800_000).contains(&n))
+        || (native && !invoked)
+    {
+        return Err("invalid partial preparation/native receipt");
+    }
+    let valid = match outcome {
+        "decoded" => prepared.is_some() && origin == Some(job) && invoked && native,
+        "hit" => {
+            prepared.is_some() && origin.is_some_and(|id| id > 0 && id < job) && !invoked && !native
+        }
+        "not-admitted" => prepared.is_none() && origin.is_none() && !invoked && !native,
+        "failed" | "invalid-context" | "revoked" => origin.is_none(),
+        _ => false,
+    };
+    if valid {
+        Ok(())
+    } else {
+        Err("inconsistent scoped reuse outcome")
+    }
+}
+#[cfg(test)]
+mod reuse_tests {
+    use super::*;
+    #[test]
+    fn receipts_do_not_invent_native_work_or_missing_preparation() {
+        let hash = [1; 32];
+        assert!(reuse_shape("decoded", Some(16000), Some(&hash), Some(7), true, false, 7).is_err());
+        assert!(reuse_shape("decoded", Some(16000), Some(&hash), Some(7), true, true, 7).is_ok());
+        assert!(reuse_shape("not-admitted", None, None, None, false, false, 7).is_ok());
+        assert!(
+            reuse_shape(
+                "not-admitted",
+                Some(16000),
+                Some(&hash),
+                None,
+                false,
+                false,
+                7
+            )
+            .is_err()
+        );
+        assert!(reuse_shape("hit", Some(16000), Some(&hash), Some(7), false, false, 7).is_err());
+        assert!(reuse_shape("revoked", None, None, None, false, false, 7).is_ok());
+    }
+}
+
+#[cfg(test)]
+mod prefix_invocation_tests {
+    use super::*;
+    #[test]
+    fn cancelled_actual_invocation_cannot_use_disjoint_slice_geometry() {
+        let prepared = vec![0.125; 16000];
+        let disjoint = Identity {
+            session: 9,
+            generation: 1,
+            job: 7,
+            storage_start: 0,
+            storage_end: 6080,
+            timeline_start: 320,
+            timeline_end: 6400,
+            frames: 6080,
+            language: Some("de"),
+        };
+        // This is a valid legacy suffix; admission/settlement also succeed.
+        assert!(
+            disjoint
+                .compare(&prepared[320..6400], "de", &prepared)
+                .is_ok()
+        );
+        assert!(admission(6400, Some(false), Some(11200), 16000, Some(2), [(16000, 1)]).is_ok());
+        assert_eq!(settlement(true, true, true, 1, true, true), Ok(true));
+        assert!(
+            disjoint
+                .compare_prefix(&prepared[320..6400], "de", &prepared, Some(false))
+                .is_err()
+        );
+        let prefix = Identity {
+            timeline_start: 0,
+            storage_end: 6400,
+            frames: 6400,
+            ..disjoint.clone()
+        };
+        assert!(
+            prefix
+                .compare_prefix(&prepared[..6400], "de", &prepared, Some(false))
+                .is_ok()
+        );
+        assert!(
+            prefix
+                .compare_prefix(&prepared[..6400], "de", &prepared, Some(true))
+                .is_err()
+        );
+        assert!(
+            prefix
+                .compare_prefix(&prepared[..6400], "de", &prepared, None)
+                .is_err()
+        );
+        let whole = Identity {
+            storage_end: 16000,
+            timeline_end: 16000,
+            frames: 16000,
+            ..prefix
+        };
+        assert!(
+            whole
+                .compare_prefix(&prepared, "de", &prepared, Some(true))
+                .is_ok()
+        );
+    }
+}
