+                cycles: 3,
+                timeout: Duration::from_secs(5),
+            },
+            |_| {},
+        );
+        let cleanup = crate::shared::cleanup(runtime);
+        let evidence = control.observation_after_cleanup();
+        assert!(cleanup.joined);
+        assert!(report.behavior_passed, "{:?}", report.first_error);
+        assert_eq!(report.rows[2].operation, Operation::CancelDecoderEntry);
+        assert_eq!(report.rows[2].terminal.as_deref(), Some("Cancelled"));
+        assert!(report.rows[2].held_decoder_ordinal.is_some());
+        assert_eq!(report.rows[2].decoder_started, 1);
+        assert!(report.rows[2].text_absent);
+        assert!(
+            report.rows[..2]
+                .iter()
+                .all(|r| r.owner_free_confirmed_by_next_start)
+        );
+        assert_eq!(evidence["valid"], true);
+        // This witnesses the expected-fixture wrapper Arc only, not product
+        // journal Weak ownership (covered by separate production tests).
+        assert_eq!(Arc::strong_count(&samples), 1);
+        Ok(())
+    }
+}
