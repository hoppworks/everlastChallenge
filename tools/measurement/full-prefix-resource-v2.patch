+//! Pure, bounded identity/coverage checks for the developer resource adapter.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Identity {
+    pub session: u64,
+    pub generation: u64,
+    pub job: u64,
+    pub storage_start: usize,
+    pub storage_end: usize,
+    pub timeline_start: usize,
+    pub timeline_end: usize,
+    pub frames: usize,
+    pub language: Option<&'static str>,
+}
+impl Identity {
+    /// Every actual FullPrefix invocation must use zero-based cumulative PCM.
+    pub fn compare_prefix(
+        &self,
+        actual: &[f32],
+        language: &str,
+        prepared: &[f32],
+        released: Option<bool>,
+    ) -> Result<(), &'static str> {
+        if self.timeline_start != 0
+            || self.storage_start != 0
+            || self.storage_end != self.timeline_end
+            || self.frames != self.timeline_end
+            || self.frames == 0
+            || self.frames > prepared.len()
+            || released.is_none()
+            || (released == Some(true) && self.timeline_end != prepared.len())
+        {
+            return Err("actual FullPrefix invocation is not cumulative or released whole input");
+        }
+        self.compare(actual, language, prepared)
+    }
+    pub fn compare(
+        &self,
+        actual: &[f32],
+        language: &str,
+        prepared: &[f32],
+    ) -> Result<(), &'static str> {
+        let count = self
+            .timeline_end
+            .checked_sub(self.timeline_start)
+            .ok_or("reversed timeline")?;
+        if count == 0
+            || self.storage_end.checked_sub(self.storage_start) != Some(count)
+            || self.frames != count
+            || self.language != Some(language)
+        {
+            return Err("decoder identity/range/language mismatch");
+        }
+        let expected = prepared
+            .get(self.timeline_start..self.timeline_end)
+            .ok_or("timeline exceeds prepared input")?;
+        if actual.len() != count
+            || !actual
+                .iter()
+                .zip(expected)
+                .all(|(a, b)| a.to_bits() == b.to_bits())
+        {
+            return Err("actual decoder PCM differs from identified prepared range");
+        }
+        Ok(())
+    }
+}
+pub fn unique_active<T>(
+    records: impl IntoIterator<Item = T>,
+    mut active: impl FnMut(&T) -> bool,
+) -> Result<T, &'static str> {
+    let mut selected = None;
+    for record in records {
+        if active(&record) {
+            if selected.is_some() {
+                return Err("ambiguous actual decoder identity");
+            }
+            selected = Some(record);
+        }
+    }
+    selected.ok_or("missing actual decoder identity")
+}
+pub fn coverage<'a>(
+    records: impl IntoIterator<Item = &'a Identity>,
+    session: u64,
+    frames: usize,
+) -> Result<(), &'static str> {
+    let mut end = 0;
+    let mut generation = None;
+    let mut previous_job = None;
+    for record in records {
+        if generation.is_some_and(|g| g != record.generation)
+            || record.session != session
+            || record.timeline_start != end
+            || record.timeline_end <= end
+            || previous_job.is_some_and(|old| record.job <= old)
+        {
+            return Err("Stop coverage has gap/overlap/stale identity/order");
+        }
+        generation = Some(record.generation);
+        end = record.timeline_end;
+        previous_job = Some(record.job);
+    }
+    if end != frames {
+        return Err("Stop coverage is incomplete");
+    }
+    Ok(())
+}
+pub fn stable(
+    required: usize,
+    submitted: u128,
+    publications: impl IntoIterator<Item = (usize, u128)>,
+) -> Result<(), &'static str> {
+    let available = publications
+        .into_iter()
+        .filter(|(_, after)| *after <= submitted)
+        .map(|(end, _)| end)
+        .max()
+        .unwrap_or(0);
+    if required > available {
+        return Err("job admitted before actual publication stabilized its frames");
+    }
+    Ok(())
+}
+pub fn settlement(
+    before: bool,
+    after: bool,
+    settled: bool,
+    receipts: usize,
+    returned: bool,
+    exact: bool,
+) -> Result<bool, &'static str> {
+    if !settled {
+        if after {
+            return Err("worker after-decode lacks settlement");
+        }
+        return Ok(false);
+    }
+    if before {
+        if !after || receipts != 1 || !returned || !exact {
+            return Err("settled actual decode lacks matching after/receipt/PCM evidence");
+        }
+    } else if after || receipts != 0 {
+        return Err("non-decoded cancelled job has fabricated decode evidence");
+    }
+    Ok(true)
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn key(start: usize, end: usize, job: u64) -> Identity {
+        Identity {
+            session: 9,
+            generation: 3,
+            job,
+            storage_start: 0,
+            storage_end: end - start,
+            timeline_start: start,
+            timeline_end: end,
+            frames: end - start,
+            language: Some("de"),
+        }
+    }
+    #[test]
+    fn range_identity_is_not_discovered_by_hash_or_local_storage() {
+        let audio = [0.1, 0.2, 0.3, 0.4];
+        let id = key(2, 4, 11);
+        assert!(id.compare(&audio[2..], "de", &audio).is_ok());
+        assert!(id.compare(&audio[..2], "de", &audio).is_err());
+        assert!(id.compare(&audio[2..], "en", &audio).is_err());
+    }
+    #[test]
+    fn exactly_one_current_or_retired_active_call() {
+        assert!(unique_active([0, 1, 0], |x| *x == 1).is_ok());
+        assert!(unique_active([0, 0], |x| *x == 1).is_err());
+        assert!(unique_active([1, 1], |x| *x == 1).is_err());
+    }
+    #[test]
+    fn stop_coverage_requires_every_frame_and_monotone_jobs() {
+        let good = [key(0, 2, 7), key(2, 4, 8)];
+        assert!(coverage(good.iter(), 9, 4).is_ok());
+        assert!(coverage(good.iter(), 9, 5).is_err());
+        assert!(coverage(good.iter(), 10, 4).is_err());
+        assert!(coverage([key(0, 2, 7), key(1, 4, 8)].iter(), 9, 4).is_err());
+        assert!(coverage([key(0, 2, 7), key(2, 4, 7)].iter(), 9, 4).is_err());
+    }
+    #[test]
+    fn before_publish_is_not_stable_evidence() {
+        assert!(stable(320, 11, [(320, 12)]).is_err());
+        assert!(stable(320, 12, [(320, 12)]).is_ok());
+        assert!(stable(640, 12, [(320, 12)]).is_err());
+    }
+}
+
+#[cfg(test)]
+mod settlement_tests {
+    use super::*;
+    #[test]
+    fn actual_decode_requires_after_and_matching_returned_receipt() {
+        assert!(settlement(true, false, true, 1, true, true).is_err());
+        assert!(settlement(true, true, true, 0, false, false).is_err());
+        assert!(settlement(true, true, true, 2, true, true).is_err());
+        assert!(settlement(true, true, true, 1, false, true).is_err());
+        assert!(settlement(true, true, true, 1, true, false).is_err());
+        assert_eq!(settlement(true, true, true, 1, true, true), Ok(true));
+    }
+    #[test]
+    fn cancelled_pending_never_fabricates_decoder_receipt() {
+        assert_eq!(settlement(false, false, false, 0, false, false), Ok(false));
+        assert_eq!(settlement(false, false, true, 0, false, false), Ok(true));
+        assert!(settlement(false, false, true, 1, true, true).is_err());
+        assert!(settlement(false, true, true, 0, false, false).is_err());
+    }
+}
