@@ -0,0 +1,337 @@
+//! Text/PCM-free actual worker identities for the resource experiment only.
+use super::identity;
+use everlast_dictation::runtime::measurement::{
+    MeasuredJobTrace,
+    job_trace::{JobTraceRecord, JobTraceSnapshot, MAX_JOBS},
+};
+use serde::Serialize;
+use std::sync::{Mutex, OnceLock};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize)]
+pub enum Mode {
+    Baseline,
+    ReferenceTrace,
+    CandidateMeasurement,
+    FullPrefixReference,
+    FullPrefixCandidate,
+}
+impl Mode {
+    pub fn full_prefix(self) -> bool {
+        matches!(self, Self::FullPrefixReference | Self::FullPrefixCandidate)
+    }
+    pub fn candidate(self) -> bool {
+        matches!(self, Self::CandidateMeasurement | Self::FullPrefixCandidate)
+    }
+    pub fn parse(flag: &str) -> Option<Self> {
+        match flag {
+            "--reference-trace" => Some(Self::ReferenceTrace),
+            "--candidate-measurement" => Some(Self::CandidateMeasurement),
+            "--full-prefix-reference" => Some(Self::FullPrefixReference),
+            "--full-prefix-candidate" => Some(Self::FullPrefixCandidate),
+            _ => None,
+        }
+    }
+}
+#[derive(Clone, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Receipt {
+    pub ordinal: u64,
+    pub identity: JobTraceRecord,
+    pub pcm_exact: bool,
+    pub decoder_returned: bool,
+    pub decode_context: Option<(u64, u64, u64)>,
+    pub decoder_error: Option<String>,
+    pub prepared_reuse: Option<everlast_dictation::transcription::prefix_cache::PreparedReuse>,
+}
+const MAX_RECEIPTS: usize =
+    (super::WARMUP_RUNS as usize + super::MEASURED_RUNS as usize) * (MAX_JOBS + 1);
+
+pub struct Observation {
+    pub mode: Mode,
+    reader: OnceLock<MeasuredJobTrace>,
+    receipts: Mutex<Vec<Receipt>>,
+}
+pub fn key(record: &JobTraceRecord) -> identity::Identity {
+    identity::Identity {
+        session: record.session,
+        generation: record.generation,
+        job: record.job_id,
+        storage_start: record.storage_start,
+        storage_end: record.storage_end,
+        timeline_start: record.timeline_start,
+        timeline_end: record.timeline_end,
+        frames: record.input_frames,
+        language: record.language,
+    }
+}
+pub fn healthy(snapshot: &JobTraceSnapshot) -> Result<(), String> {
+    if !snapshot.enabled
+        || snapshot.maximum_jobs != MAX_JOBS
+        || snapshot.error.is_some()
+        || snapshot.overflow_events != 0
+        || snapshot.first_overflow_job.is_some()
+        || snapshot.jobs.len() > MAX_JOBS
+    {
+        return Err("resource job trace unavailable, invalid or overflowed".into());
+    }
+    Ok(())
+}
+impl Observation {
+    pub fn new(mode: Mode) -> Self {
+        Self {
+            mode,
+            reader: OnceLock::new(),
+            receipts: Mutex::new(Vec::new()),
+        }
+    }
+    pub fn attach(&self, reader: MeasuredJobTrace) -> Result<(), String> {
+        self.reader
+            .set(reader)
+            .map_err(|_| "resource trace already attached".into())
+    }
+    pub fn snapshot(&self) -> Result<JobTraceSnapshot, String> {
+        let result = self
+            .reader
+            .get()
+            .ok_or("resource trace not attached")?
+            .snapshot()
+            .map_err(|_| "resource trace snapshot failed")?;
+        Ok(result)
+    }
+    pub fn enter(
+        &self,
+        ordinal: u64,
+        audio: &[f32],
+        language: &str,
+        expected: &[f32],
+    ) -> Result<(), String> {
+        let snapshot = self.snapshot()?;
+        healthy(&snapshot)?;
+        let active =
+            identity::unique_active(snapshot.jobs.into_iter().chain(snapshot.retired_job), |r| {
+                r.worker_before_decode_offset_nanos.is_some()
+                    && r.worker_after_decode_offset_nanos.is_none()
+                    && r.worker_settled_offset_nanos.is_none()
+            })?;
+        // Snapshot owns no PCM; release its other records before any gate wait.
+        let exact = if self.mode.full_prefix() {
+            key(&active).compare_prefix(audio, language, expected, active.audio_released_at_submit)
+        } else {
+            key(&active).compare(audio, language, expected)
+        };
+        let mut receipts = self
+            .receipts
+            .lock()
+            .map_err(|_| "resource receipt lock poisoned")?;
+        if receipts.last().is_some_and(|last| {
+            last.ordinal.checked_add(1) != Some(ordinal) || last.identity.job_id >= active.job_id
+        }) {
+            return Err("actual worker invocation ordinal/global job order changed".into());
+        }
+        if receipts.len() >= MAX_RECEIPTS
+            || receipts.iter().any(|r| key(&r.identity) == key(&active))
+        {
+            return Err("resource receipt limit or duplicate actual invocation".into());
+        }
+        receipts
+            .try_reserve(1)
+            .map_err(|_| "resource receipt allocation failed")?;
+        receipts.push(Receipt {
+            ordinal,
+            identity: active,
+            pcm_exact: exact.is_ok(),
+            decoder_returned: false,
+            decode_context: None,
+            decoder_error: None,
+            prepared_reuse: None,
+        });
+        exact.map_err(str::to_owned)
+    }
+    pub fn context(
+        &self,
+        ordinal: u64,
+        context: &everlast_dictation::inference_service::DecodeContext,
+    ) -> Result<(), String> {
+        let mut receipts = self
+            .receipts
+            .lock()
+            .map_err(|_| "resource receipt lock poisoned")?;
+        let receipt = receipts.last_mut().ok_or("missing scoped invocation")?;
+        if receipt.ordinal != ordinal
+            || (
+                receipt.identity.session,
+                receipt.identity.generation,
+                receipt.identity.job_id,
+            ) != (context.session, context.generation, context.job_id)
+        {
+            return Err("actual scoped context differs from worker trace".into());
+        }
+        receipt.decode_context = Some((context.session, context.generation, context.job_id));
+        Ok(())
+    }
+    pub fn returned_result(&self, ordinal: u64, error: Option<String>) -> Result<(), String> {
+        self.returned(ordinal)?;
+        let mut receipts = self
+            .receipts
+            .lock()
+            .map_err(|_| "resource receipt lock poisoned")?;
+        let receipt = receipts
+            .last_mut()
+            .ok_or("missing returned scoped invocation")?;
+        if receipt.ordinal != ordinal {
+            return Err("stale returned scoped invocation".into());
+        }
+        receipt.decoder_error = error;
+        Ok(())
+    }
+    pub fn prepared_reuse(
+        &self,
+        value: Option<everlast_dictation::transcription::prefix_cache::PreparedReuse>,
+    ) -> Result<(), String> {
+        let mut receipts = self
+            .receipts
+            .lock()
+            .map_err(|_| "resource receipt lock poisoned")?;
+        let receipt = receipts.last_mut().ok_or("missing scoped reuse owner")?;
+        let value = value.ok_or("missing actual scoped reuse receipt")?;
+        if receipt.prepared_reuse.is_some()
+            || !receipt.decoder_returned
+            || receipt.decode_context != Some((value.session, value.generation, value.job_id))
+        {
+            return Err("foreign/duplicate/missing scoped reuse receipt".into());
+        }
+        receipt.prepared_reuse = Some(value);
+        Ok(())
+    }
+    pub fn returned(&self, ordinal: u64) -> Result<(), String> {
+        let mut receipts = self
+            .receipts
+            .lock()
+            .map_err(|_| "resource receipt lock poisoned")?;
+        let receipt = receipts
+            .iter_mut()
+            .find(|r| r.ordinal == ordinal)
+            .ok_or("resource decoder receipt missing")?;
+        if receipt.decoder_returned {
+            return Err("resource decoder returned twice".into());
+        }
+        receipt.decoder_returned = true;
+        Ok(())
+    }
+    pub fn is_early_prefix(&self, ordinal: u64) -> Result<bool, String> {
+        let receipts = self
+            .receipts
+            .lock()
+            .map_err(|_| "resource receipt lock poisoned")?;
+        Ok(receipts
+            .iter()
+            .find(|r| r.ordinal == ordinal)
+            .is_some_and(|r| r.identity.audio_released_at_submit == Some(false)))
+    }
+    pub fn receipts(&self) -> Result<Vec<Receipt>, String> {
+        Ok(self
+            .receipts
+            .lock()
+            .map_err(|_| "resource receipt lock poisoned")?
+            .clone())
+    }
+    pub fn reconciled(&self, snapshot: &JobTraceSnapshot) -> Result<bool, String> {
+        healthy(snapshot)?;
+        let receipts = self
+            .receipts
+            .lock()
+            .map_err(|_| "resource receipt lock poisoned")?;
+        for record in snapshot.jobs.iter().chain(snapshot.retired_job.iter()) {
+            let matching: Vec<_> = receipts
+                .iter()
+                .filter(|r| key(&r.identity) == key(record))
+                .collect();
+            if record.service_accepted_offset_nanos.is_none() {
+                return Err("resource host job was not service-accepted".into());
+            }
+            let settled = identity::settlement(
+                record.worker_before_decode_offset_nanos.is_some(),
+                record.worker_after_decode_offset_nanos.is_some(),
+                record.worker_settled_offset_nanos.is_some(),
+                matching.len(),
+                matching.first().is_some_and(|r| r.decoder_returned),
+                matching.first().is_some_and(|r| r.pcm_exact),
+            )?;
+            if !settled {
+                return Ok(false);
+            }
+            if self.mode.full_prefix() && record.worker_before_decode_offset_nanos.is_some() {
+                let receipt = matching.first().ok_or("missing full-prefix actual call")?;
+                let reuse = receipt
+                    .prepared_reuse
+                    .as_ref()
+                    .ok_or("missing full-prefix actual reuse receipt")?;
+                use everlast_dictation::transcription::prefix_cache::ReuseOutcome;
+                if (reuse.session, reuse.generation, reuse.job_id)
+                    != (record.session, record.generation, record.job_id)
+                {
+                    return Err("full-prefix receipt changed scope".into());
+                }
+                let outcome = match reuse.outcome {
+                    ReuseOutcome::Decoded => "decoded",
+                    ReuseOutcome::Hit => "hit",
+                    ReuseOutcome::NotAdmitted => "not-admitted",
+                    ReuseOutcome::Failed => "failed",
+                    ReuseOutcome::InvalidContext => "invalid-context",
+                    ReuseOutcome::Revoked => "revoked",
+                };
+                identity::reuse_shape(
+                    outcome,
+                    reuse.prepared_frames,
+                    reuse.prepared_pcm_sha256.as_ref(),
+                    reuse.origin_job_id,
+                    reuse.decoder_invoked,
+                    reuse.native_full_attempted,
+                    reuse.job_id,
+                )?;
+                match reuse.outcome {
+                    ReuseOutcome::Decoded
+                        if !reuse.decoder_invoked
+                            || !reuse.native_full_attempted
+                            || reuse.origin_job_id != Some(record.job_id) =>
+                    {
+                        return Err("decoded receipt lacks actual native call".into());
+                    }
+                    ReuseOutcome::Hit
+                        if !self.mode.candidate()
+                            || reuse.decoder_invoked
+                            || reuse.native_full_attempted
+                            || !receipts
+                                .iter()
+                                .take_while(|old| old.ordinal < receipt.ordinal)
+                                .filter(|old| {
+                                    old.identity.session == record.session
+                                        && old.identity.generation == record.generation
+                                })
+                                .filter_map(|old| old.prepared_reuse.as_ref())
+                                .fold(None, |live, prior| match prior.outcome {
+                                    ReuseOutcome::Decoded => Some(prior),
+                                    ReuseOutcome::Hit => live,
+                                    _ => None,
+                                })
+                                .is_some_and(|prior| {
+                                    prior.job_id < reuse.job_id
+                                        && Some(prior.job_id) == reuse.origin_job_id
+                                        && prior.prepared_frames == reuse.prepared_frames
+                                        && prior.prepared_pcm_sha256 == reuse.prepared_pcm_sha256
+                                }) =>
+                    {
+                        return Err("cache hit lacks actual current-scope native origin".into());
+                    }
+                    ReuseOutcome::Failed | ReuseOutcome::InvalidContext | ReuseOutcome::Revoked
+                        if record.worker_outcome == Some("decoded-ok") =>
+                    {
+                        return Err("accepted job has failed/revoked cache receipt".into());
+                    }
+                    _ => {}
+                }
+            }
+        }
+        Ok(true)
+    }
+}
