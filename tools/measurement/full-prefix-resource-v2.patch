+// SOURCE-ONLY until the Mac integration check. Receipt/native flags below are
+// deterministic test doubles, never actual backend or resource evidence.
+#[cfg(test)]
+mod full_prefix_contract_tests {
+    use super::*;
+    use dictation_core::audio::AudioFormat;
+    use everlast_dictation::{
+        inference_service::{DecodeContext, InferenceService},
+        transcription::prefix_cache::{PreparedReuse, ReuseOutcome},
+    };
+    struct Scoped {
+        receipt: Option<PreparedReuse>,
+        dropped: Arc<AtomicBool>,
+    }
+    impl Drop for Scoped {
+        fn drop(&mut self) {
+            self.dropped.store(true, Ordering::Release);
+        }
+    }
+    impl Decoder for Scoped {
+        fn decode(&mut self, _: &[f32], _: Language) -> Result<String, InferenceError> {
+            Err(InferenceError::InvalidDecodeContext)
+        }
+        fn decode_with_context(
+            &mut self,
+            pcm: &[f32],
+            _: Language,
+            scope: &DecodeContext,
+        ) -> Result<String, InferenceError> {
+            let valid = scope.is_valid();
+            self.receipt = Some(PreparedReuse {
+                session: scope.session,
+                generation: scope.generation,
+                job_id: scope.job_id,
+                outcome: if valid {
+                    ReuseOutcome::Decoded
+                } else {
+                    ReuseOutcome::InvalidContext
+                },
+                origin_job_id: valid.then_some(scope.job_id),
+                prepared_frames: valid.then_some(pcm.len().max(16000)),
+                prepared_pcm_sha256: valid.then_some([3; 32]),
+                decoder_invoked: valid,
+                native_full_attempted: valid,
+            });
+            if valid {
+                Ok(if pcm.len() == 32000 {
+                    "whole"
+                } else {
+                    "revision"
+                }
+                .into())
+            } else {
+                Err(InferenceError::InvalidDecodeContext)
+            }
+        }
+        fn take_prepared_reuse(&mut self) -> Option<PreparedReuse> {
+            self.receipt.take()
+        }
+    }
+    #[test]
+    fn full_prefix_resource_stop_cancel_settlement_and_owned_drop_are_retained()
+    -> Result<(), Box<dyn std::error::Error>> {
+        for mode in [Mode::FullPrefixReference, Mode::FullPrefixCandidate] {
+            let mut pcm = vec![0.125; 16000];
+            pcm.resize(32000, 0.0);
+            let samples: Arc<[f32]> = pcm.into();
+            let expected = Arc::clone(&samples);
+            let dropped = Arc::new(AtomicBool::new(false));
+            let marker = Arc::clone(&dropped);
+            let (send, receive) = bounded(1);
+            let service = InferenceService::with_initializer(move || {
+                let (decoder, control) = controlled_observed(
+                    Scoped {
+                        receipt: None,
+                        dropped: marker,
+                    },
+                    expected,
+                    Duration::from_secs(6),
+                    mode,
+                );
+                send.send(control).map_err(|_| InferenceError::Decode)?;
+                Ok(decoder)
+            })?;
+            let control = receive.recv_timeout(Duration::from_secs(2))?;
+            let format = AudioFormat {
+                sample_rate: 16000,
+                channels: 1,
+            };
+            let runtime = if mode.candidate() {
+                MeasuredRuntime::spawn_full_prefix_revision(service, 1, format)?
+            } else {
+                MeasuredRuntime::spawn_pretranscription_reference(service, 1, format)?
+            };
+            control.attach_trace(runtime.job_trace_handle())?;
+            crate::shared::wait_ready(&runtime)?;
+            let report = workload(
+                &runtime,
+                &control,
+                &samples,
+                "whole",
+                Config {
+                    warmups: 1,
+                    cycles: 3,
+                    timeout: Duration::from_secs(5),
+                },
+                |_| {},
+            );
+            let cleanup = crate::shared::cleanup(runtime);
+            let observed = control.observation_after_cleanup();
+            assert!(cleanup.joined);
+            assert!(dropped.load(Ordering::Acquire));
+            assert!(report.behavior_passed, "{:?}", report.first_error);
+            assert_eq!(report.rows.len(), 4);
+            assert_eq!(report.rows[3].terminal.as_deref(), Some("Cancelled"));
+            assert!(report.rows[3].held_decoder_ordinal.is_some());
+            assert!(report.rows[3].text_absent);
+            assert!(
+                report.rows[..3]
+                    .iter()
+                    .all(|row| row.owner_free_confirmed_by_next_start)
+            );
+            assert_eq!(observed["valid"], true);
+            assert!(
+                observed["actualDecoderReceipts"]
+                    .as_array()
+                    .is_some_and(|receipts| receipts
+                        .iter()
+                        .any(|receipt| receipt["decoderError"].is_string()
+                            && receipt["preparedReuse"]["outcome"] == "invalid-context"))
+            );
+        }
+        Ok(())
+    }
+}
