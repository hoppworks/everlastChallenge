+        let p = c.finish();
+        assert_eq!(p.error, Some("native perf snapshot failed"));
+        let record = p.native_perf.ok_or("actual error record missing")?;
+        assert!(
+            record
+                .snapshot
+                .as_ref()
+                .ok_or("read was attempted")?
+                .is_err()
+        );
+        assert!(record.full_succeeded);
+        assert_eq!(record.read_elapsed.ok_or("actual duration")?.as_nanos(), 7);
+        Ok(())
+    }
