+#![deny(unsafe_code)]
+#[cfg(all(test, feature = "diagnostic"))]
+mod tests {
+    #[test]
+    #[allow(
+        unsafe_code,
+        reason = "Null-only call proves actual diagnostic ABI symbol links; no native objects/models"
+    )]
+    fn generated_ffi_layout_and_exclusive_safe_accessor_compile() {
+        use std::mem::{align_of, offset_of, size_of};
+        type Raw = whisper_rs_sys::whisper_state_perf_snapshot;
+        let _: unsafe extern "C" fn(*const whisper_rs_sys::whisper_state, *mut Raw) -> i32 =
+            whisper_rs_sys::whisper_state_get_perf_snapshot;
+        let _: fn(&mut whisper_rs::WhisperState) -> Result<Raw, whisper_rs::WhisperError> =
+            whisper_rs::WhisperState::native_perf_snapshot;
+        // SAFETY: the getter explicitly accepts null arguments and returns -1.
+        // Neither argument is dereferenced; this tests the actual linked C symbol.
+        assert_eq!(
+            unsafe {
+                whisper_rs_sys::whisper_state_get_perf_snapshot(
+                    std::ptr::null(),
+                    std::ptr::null_mut(),
+                )
+            },
+            -1
+        );
+        assert_eq!(size_of::<Raw>(), 80);
+        assert_eq!(align_of::<Raw>(), 8);
+        assert_eq!(offset_of!(Raw, n_encode), 48);
+        assert_eq!(offset_of!(Raw, n_fail_h), 72);
+    }
+}
