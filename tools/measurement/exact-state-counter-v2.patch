+        let raw = whisper_rs::NativeStatePerfSnapshot {
+            mel_us: 1,
+            encode_us: 2,
+            decode_us: 0,
+            batchd_us: 0,
+            prompt_us: 0,
+            sample_us: 0,
+            n_encode: 2,
+            n_decode: 7,
+            n_batchd: 19,
+            n_prompt: 23,
+            n_sample: 11,
+            n_fail_p: 3,
+            n_fail_h: 5,
+        };
+        let value = renderer::render(Ok(&raw), 71, false, Some(2000));
+        assert_eq!(value["status"], "captured");
+        assert_eq!(value["fullSucceeded"], false);
+        assert_eq!(value["getterWallNanos"], 71);
+        assert_eq!(value["wallMinusCounterSumNanos"], "-1000");
+        assert_eq!(value["raw"]["encodeCalls"], 2);
+        assert_eq!(value["raw"]["batchdTokens"], 19);
+        assert_eq!(value["raw"]["promptTokens"], 23);
+        assert_eq!(value["raw"]["logprobFailures"], 3);
+        assert_eq!(value["raw"]["entropyFailures"], 5);
+    }
+    #[test]
+    fn absent_and_failed_observations_never_invent_zero_counters() {
+        let absent = renderer::not_reached();
+        assert_eq!(absent["status"], "not-reached");
+        assert!(absent["raw"].is_null() && absent["getterWallNanos"].is_null());
+        let error = renderer::render(Err("controlled getter failure"), 5, true, Some(100));
+        assert_eq!(error["status"], "capture-error");
+        assert!(error["raw"].is_null() && error["wallMinusCounterSumNanos"].is_null());
+        assert_eq!(error["fullSucceeded"], true);
+    }
