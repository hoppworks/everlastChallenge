+// Synthetic states only: no context init, backend init, model, audio or ASR.
+#include "../whisper.cpp/src/whisper.cpp"
+#include <cassert>
+#ifdef NDEBUG
+#error "contract assertions must stay enabled"
+#endif
+#include <cstddef>
+#include <limits>
+#include <type_traits>
+int main() {
+    static_assert(std::is_standard_layout<whisper_state_perf_snapshot>::value, "POD layout");
+    static_assert(sizeof(whisper_state_perf_snapshot) == 80, "64-bit ABI size");
+    static_assert(alignof(whisper_state_perf_snapshot) == 8, "64-bit ABI alignment");
+    static_assert(offsetof(whisper_state_perf_snapshot, n_encode) == 48, "counter offset");
+    static_assert(offsetof(whisper_state_perf_snapshot, n_fail_h) == 72, "last offset");
+    whisper_state state{};
+    state.t_mel_us = 11; state.t_encode_us = 23; state.t_decode_us = 37;
+    state.t_batchd_us = 41; state.t_prompt_us = 59; state.t_sample_us = 61;
+    state.n_encode = 2; state.n_decode = 3; state.n_batchd = 17;
+    state.n_prompt = 19; state.n_sample = 7; state.n_fail_p = 5; state.n_fail_h = 13;
+    state.prompt_past0 = {31, 32}; state.prompt_past1 = {43};
+    const auto rng = state.decoders[0].rng;
+    whisper_state_perf_snapshot out{};
+    out.mel_us = -999;
+    assert(whisper_state_get_perf_snapshot(nullptr, &out) == -1);
+    assert(out.mel_us == -999); // null state must not partially initialize output
+    assert(whisper_state_get_perf_snapshot(&state, nullptr) == -1);
+    assert(whisper_state_get_perf_snapshot(&state, &out) == 0);
+    assert(out.mel_us == 11 && out.encode_us == 23 && out.decode_us == 37);
+    assert(out.batchd_us == 41 && out.prompt_us == 59 && out.sample_us == 61);
+    assert(out.n_encode == 2 && out.n_decode == 3 && out.n_batchd == 17);
+    assert(out.n_prompt == 19 && out.n_sample == 7 && out.n_fail_p == 5 && out.n_fail_h == 13);
+    assert(state.t_encode_us == 23 && state.n_prompt == 19);
+    assert((state.prompt_past0 == std::vector<whisper_token>{31, 32}));
+    assert((state.prompt_past1 == std::vector<whisper_token>{43}));
+    assert(state.decoders[0].rng == rng);
+    state.t_mel_us = std::numeric_limits<int64_t>::max();
+    state.n_fail_h = std::numeric_limits<int32_t>::min();
+    assert(whisper_state_get_perf_snapshot(&state, &out) == 0);
+    assert(out.mel_us == std::numeric_limits<int64_t>::max());
+    assert(out.n_fail_h == std::numeric_limits<int32_t>::min()); // raw, never clamped
+    return 0;
+}
