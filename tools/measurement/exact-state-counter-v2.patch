+//! Observational derivative only: signed raw values; never a disjoint partition.
+use serde_json::{Value, json};
+pub fn render(
+    raw: Result<&whisper_rs::NativeStatePerfSnapshot, &str>,
+    read_nanos: u128,
+    full_succeeded: bool,
+    full_wall_nanos: Option<u128>,
+) -> Value {
+    match raw {
+        Err(error) => json!({"status":"capture-error", "error":error,
+            "getterWallNanos":read_nanos,"fullSucceeded":full_succeeded,
+            "raw":null,"wallMinusCounterSumNanos":null}),
+        Ok(s) => {
+            let sum_us = i128::from(s.mel_us)
+                + i128::from(s.encode_us)
+                + i128::from(s.decode_us)
+                + i128::from(s.batchd_us)
+                + i128::from(s.prompt_us)
+                + i128::from(s.sample_us);
+            let residual = full_wall_nanos
+                .and_then(|n| i128::try_from(n).ok())
+                .map(|n| (n - sum_us * 1000).to_string());
+            // Decimal string preserves signed i128 exactly, including negative residuals.
+            json!({"status":"captured","error":null,"getterWallNanos":read_nanos,
+                "fullSucceeded":full_succeeded,"wallMinusCounterSumNanos":residual,
+                "raw":{"melUs":s.mel_us,"encodeUs":s.encode_us,"decodeUs":s.decode_us,
+                    "batchdUs":s.batchd_us,"promptUs":s.prompt_us,"sampleUs":s.sample_us,
+                    "encodeCalls":s.n_encode,"singleTokenDecodeCalls":s.n_decode,
+                    "batchdTokens":s.n_batchd,"promptTokens":s.n_prompt,"sampledTokens":s.n_sample,
+                    "logprobFailures":s.n_fail_p,"entropyFailures":s.n_fail_h}})
+        }
+    }
+}
+
+pub fn not_reached() -> Value {
+    json!({"status":"not-reached","raw":null,"getterWallNanos":null,
+        "fullSucceeded":null,"wallMinusCounterSumNanos":null,"error":null})
+}
+
+pub fn native_error() -> Value {
+    json!({"status":"not-captured-native-error","raw":null,"getterWallNanos":null,
+        "fullSucceeded":false,"wallMinusCounterSumNanos":null,"error":null})
+}
