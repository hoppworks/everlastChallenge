+        c.record_native_perf(super::profile::NativePerfRecord {
+            snapshot: Some(Err(whisper_rs::WhisperError::GenericError(-1))),
+            read_elapsed: Some(std::time::Duration::from_nanos(7)),
+            full_succeeded: true,
