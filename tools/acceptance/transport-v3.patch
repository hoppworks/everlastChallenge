+//! Separate installed adapter. No microphone, decoder, arbitrary text or product IPC.
+#![forbid(unsafe_code)]
+#[path = "transport_acceptance/state.rs"]
+mod state;
+use crossbeam_channel::{Receiver, Sender, bounded};
+use dictation_core::session::DeliveryResult;
+use everlast_dictation::{
+    hotkeys::{Event, Hotkeys},
+    native_service::NativeService,
+    runtime::{NativeCommand, NativeEndpoint, NativeResult},
+    settings::{Hotkey, PhysicalKey},
+};
+use macos_integration::{
+    acceptance_identity, clipboard::snapshot_helper_main, delivery::DeliveryToken,
+    target::ProcessIdentity,
+};
+use sha2::{Digest, Sha256};
+use std::{
+    num::NonZeroU64,
+    sync::{
+        Arc, Mutex,
+        atomic::{AtomicBool, Ordering},
+    },
+    thread,
+    time::{Duration, Instant},
+};
+use tauri::{
+    Manager,
+    menu::{Menu, MenuItem},
+    tray::TrayIconBuilder,
+};
+const IDENTIFIER: &str = "de.hoppworks.everlast-transport-acceptance";
+const FIXTURE: &str = include_str!("transport_acceptance/transport-fixture.txt");
+const FIXTURE_SHA: &str = "78ce796361f50b77b1c86a693c9ba3bb02be2be8dc7fcd0e5ddfd4305da0c5b7";
+struct Shared {
+    gate: Mutex<state::Gate>,
+    active: Mutex<Option<DeliveryToken>>,
+    closing: AtomicBool,
+    exit: state::OwnerExit,
+}
+impl Shared {
+    fn cancel(&self) {
+        if let Ok(mut gate) = self.gate.lock() {
+            gate.disarm();
+        }
+        if let Ok(active) = self.active.lock()
+            && let Some(token) = active.as_ref()
+        {
+            token.cancel();
+        }
+    }
+    fn close(&self) {
+        self.closing.store(true, Ordering::Release);
+        if let Ok(mut gate) = self.gate.lock() {
+            gate.close();
+        }
+        self.cancel();
+    }
+}
+struct Attempt {
+    session: NonZeroU64,
+    process: ProcessIdentity,
+    token: DeliveryToken,
+}
+type Status = MenuItem<tauri::Wry>;
+fn status(app: &tauri::AppHandle, item: &Status, text: &str) {
+    let item = item.clone();
+    let text = text.to_owned();
+    if app
+        .run_on_main_thread(move || {
+            if item.set_text(text).is_err() {
+                eprintln!("Adapterstatus konnte nicht gesetzt werden");
+            }
+        })
+        .is_err()
+    {
+        eprintln!("Adapterstatus nicht zustellbar");
+    }
+}
+fn finish(shared: &Shared, session: NonZeroU64) {
+    if let Ok(mut active) = shared.active.lock()
+        && active
+            .as_ref()
+            .is_some_and(|token| token.session() == session)
+    {
+        *active = None;
+    }
+    if let Ok(mut gate) = shared.gate.lock() {
+        gate.complete(session.get());
+    }
+}
+fn response(
+    receive: &Receiver<NativeResult>,
+    token: &DeliveryToken,
+    shared: &Shared,
+    timeout: Duration,
+) -> Result<NativeResult, &'static str> {
+    let deadline = Instant::now() + timeout;
+    loop {
+        if shared.closing.load(Ordering::Acquire) || (!token.is_pending() && !token.is_committed())
+        {
+            return Err("Transporttest abgebrochen");
+        }
+        match receive.recv_timeout(Duration::from_millis(20)) {
+            Ok(value) => return Ok(value),
+            Err(crossbeam_channel::RecvTimeoutError::Disconnected) => {
+                return Err("Nativdienst beendet");
+            }
+            Err(crossbeam_channel::RecvTimeoutError::Timeout) if Instant::now() < deadline => {}
+            Err(_) => return Err("Native Antwortfrist überschritten"),
+        }
+    }
+}
+fn attempt(
+    app: &tauri::AppHandle,
+    shared: &Shared,
+    request: &Attempt,
+) -> Result<&'static str, &'static str> {
+    let (send, requests) = bounded(2);
+    let (responses, receive) = bounded(2);
+    let service = NativeService::for_app(
+        NativeEndpoint {
+            requests,
+            responses,
+        },
+        app.clone(),
+    )
+    .map_err(|_| "Nativdienst konnte nicht starten")?;
+    let result = (|| {
+        send.try_send(NativeCommand::Capture {
+            session: request.session,
+            process: Some(request.process),
+            token: request.token.clone(),
+        })
+        .map_err(|_| "Zielerfassung nicht zugestellt")?;
+        match response(&receive, &request.token, shared, Duration::from_secs(5))? {
+            NativeResult::Captured {
+                session,
+                result: Ok(()),
+            } if session == request.session.get() => {}
+            _ => return Err("Startziel nicht bestätigt – nichts versandt"),
+        }
+        send.try_send(NativeCommand::Deliver {
+            session: request.session.get(),
+            text: FIXTURE.to_owned(),
+            token: request.token.clone(),
+        })
+        .map_err(|_| "Transportauftrag nicht zugestellt")?;
+        let result = match response(&receive, &request.token, shared, Duration::from_secs(15))? {
+            NativeResult::Delivered {
+                session,
+                result: DeliveryResult::Sent,
+            } if session == request.session.get() => {
+                Ok("Einfügebefehl versandt – Empfang selbst prüfen")
+            }
+            NativeResult::Delivered {
+                session,
+                result: DeliveryResult::Held(_),
+            } if session == request.session.get() => Ok("Zurückgehalten – nichts erneut versuchen"),
+            _ => Err("Transport fehlgeschlagen oder Ergebnis unklar – kein Retry"),
+        };
+        // Let the service's unchanged 500ms restore lease expire. No receipt claim.
+        let until = Instant::now() + Duration::from_millis(600);
+        while Instant::now() < until && !shared.closing.load(Ordering::Acquire) {
+            thread::sleep(Duration::from_millis(10));
+        }
+        result
+    })();
+    if result.is_err() {
+        request.token.cancel();
+    }
+    // Event loop stays alive: join may need main-thread Clipboard cleanup.
+    if service.join().is_err() {
+        shared.close();
+        return Err("Native Bereinigung fehlgeschlagen – Adapter gesperrt");
+    }
+    result
+}
+fn owner(
+    app: tauri::AppHandle,
+    shared: Arc<Shared>,
+    item: Status,
+    receive: Receiver<Attempt>,
+    send: Sender<Attempt>,
+) {
+    let callback_shared = Arc::clone(&shared);
+    let callback_app = app.clone();
+    let callback_item = item.clone();
+    let installed = Hotkeys::install(
+        app.clone(),
+        Hotkey {
+            key: PhysicalKey::D,
+            option: true,
+            command: false,
+            control: true,
+            shift: true,
+        },
+        move |event| match event {
+            Event::Cancel { session } => {
+                if let Ok(active) = callback_shared.active.lock()
+                    && let Some(token) = active.as_ref().filter(|t| t.session().get() == session)
+                {
+                    token.cancel();
+                }
+            }
+            Event::Toggle { process, origin: _ } => {
+                let fired = callback_shared
+                    .gate
+                    .lock()
+                    .ok()
+                    .and_then(|mut gate| gate.fire().ok())
+                    .flatten();
+                let Some(id) = fired.and_then(NonZeroU64::new) else {
+                    return;
+                };
+                let Some(process) = process else {
+                    finish(&callback_shared, id);
+                    status(
+                        &callback_app,
+                        &callback_item,
+                        "Kein Startziel – erneut ausdrücklich scharfschalten",
+                    );
+                    return;
+                };
+                let token = DeliveryToken::new(id);
+                if let Ok(mut active) = callback_shared.active.lock() {
+                    *active = Some(token.clone());
+                } else {
+                    token.cancel();
+                    finish(&callback_shared, id);
+                    return;
+                }
+                if callback_shared.closing.load(Ordering::Acquire) {
+                    token.cancel();
+                }
+                if send
+                    .try_send(Attempt {
+                        session: id,
+                        process,
+                        token: token.clone(),
+                    })
+                    .is_err()
+                {
+                    token.cancel();
+                    finish(&callback_shared, id);
+                    status(
+                        &callback_app,
+                        &callback_item,
+                        "Auftrag nicht angenommen – nichts versandt",
+                    );
+                }
+            }
+        },
+    );
+    let mut hotkeys = match installed {
+        Ok(value) => value,
+        Err(_) => {
+            status(
+                &app,
+                &item,
+                "Testhotkey nicht registriert – Adapter nicht bereit",
+            );
+            owner_finished(&app, &shared);
+            return;
+        }
+    };
+    if let Ok(mut gate) = shared.gate.lock() {
+        gate.ready();
+    }
+    status(
+        &app,
+        &item,
+        "Nicht scharf – zuerst im Menü einmal vorbereiten",
+    );
+    while !shared.closing.load(Ordering::Acquire) {
+        if !matches!(hotkeys.take_error(), Ok(None)) {
+            status(&app, &item, "Hotkeyfehler – Adapter gesperrt");
+            shared.close();
+            break;
+        }
+        match receive.recv_timeout(Duration::from_millis(20)) {
+            Ok(request) => {
+                let enabled = hotkeys.enable_cancel(Some(request.session.get()));
+                let result = if enabled.is_ok() {
+                    attempt(&app, &shared, &request)
+                } else {
+                    Err("Abbruchhotkey nicht verfügbar – nichts versandt")
+                };
+                let disabled = hotkeys.enable_cancel(None);
+                finish(&shared, request.session);
+                status(&app, &item, result.unwrap_or_else(|message| message));
+                if disabled.is_err() {
+                    shared.close();
+                }
+            }
+            Err(crossbeam_channel::RecvTimeoutError::Disconnected) => {
+                shared.close();
+            }
+            Err(crossbeam_channel::RecvTimeoutError::Timeout) => {}
+        }
+    }
+    shared.cancel();
+    if hotkeys.shutdown().is_err() {
+        eprintln!("Testhotkeys konnten nicht vollständig entfernt werden");
+    }
+    owner_finished(&app, &shared);
+}
+fn owner_finished(app: &tauri::AppHandle, shared: &Shared) {
+    if shared.exit.finish() {
+        app.exit(0);
+    }
+}
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    if let Some(result) = snapshot_helper_main() {
+        return result.map_err(Into::into);
+    }
+    if FIXTURE.len() != 68 || format!("{:x}", Sha256::digest(FIXTURE.as_bytes())) != FIXTURE_SHA {
+        return Err("Embedded Transportfixture stimmt nicht".into());
+    }
+    let shared = Arc::new(Shared {
+        gate: Mutex::new(state::Gate::default()),
+        active: Mutex::new(None),
+        closing: AtomicBool::new(false),
+        exit: state::OwnerExit::default(),
+    });
+    let setup_shared = Arc::clone(&shared);
+    let worker = Arc::new(Mutex::new(None::<thread::JoinHandle<()>>));
+    let setup_worker = Arc::clone(&worker);
+    let context: tauri::Context<tauri::Wry> =
+        tauri::generate_context!("examples/transport_acceptance/tauri.conf.json");
+    let app = tauri::Builder::default()
+        .plugin(tauri_plugin_global_shortcut::Builder::new().build())
+        .setup(move |app| {
+            let actual =
+                acceptance_identity::main_bundle_identifier().map_err(std::io::Error::other)?;
+            if actual.as_deref() != Some(IDENTIFIER) || app.config().identifier != IDENTIFIER {
+                return Err("Separates installiertes Transport-Testbundle erforderlich".into());
+            }
+            let own = ProcessIdentity::read(i32::try_from(std::process::id())?)?;
+            eprintln!(
+                "Transportadapter {:?}; bundle={}; fixtureSha256={}",
+                own, IDENTIFIER, FIXTURE_SHA
+            );
+            let item = MenuItem::with_id(app, "status", "Initialisierung", false, None::<&str>)?;
+            let arm =
+                MenuItem::with_id(app, "arm", "Fixture einmal vorbereiten", true, None::<&str>)?;
+            let cancel = MenuItem::with_id(
+                app,
+                "cancel",
+                "Abbrechen / Vormerkung löschen",
+                true,
+                None::<&str>,
+            )?;
+            let quit = MenuItem::with_id(app, "quit", "Testadapter beenden", true, None::<&str>)?;
+            let help = MenuItem::with_id(
+                app,
+                "help",
+                "Ziel selbst fokussieren, dann Control+Option+Shift+D",
+                false,
+                None::<&str>,
+            )?;
+            let menu = Menu::with_items(app, &[&item, &help, &arm, &cancel, &quit])?;
+            let ui_shared = Arc::clone(&setup_shared);
+            let ui_item = item.clone();
+            let tray = TrayIconBuilder::new()
+                .title("UTF-8 Test")
+                .tooltip("Separater Transport-Testadapter")
+                .menu(&menu)
+                .show_menu_on_left_click(true)
+                .on_menu_event(move |app, event| match event.id().as_ref() {
+                    "arm" => {
+                        let accepted = ui_shared
+                            .gate
+                            .lock()
+                            .ok()
+                            .is_some_and(|mut gate| gate.arm().is_ok());
+                        status(
+                            app,
+                            &ui_item,
+                            if accepted {
+                                "Einmal scharf – Ziel selbst fokussieren, dann Hotkey"
+                            } else {
+                                "Nicht bereit oder noch belegt"
+                            },
+                        );
+                    }
+                    "cancel" => {
+                        ui_shared.cancel();
+                        status(app, &ui_item, "Abbruch angefordert / Vormerkung gelöscht");
+                    }
+                    "quit" => {
+                        ui_shared.close();
+                        if ui_shared.exit.request_quit() {
+                            app.exit(0);
+                        }
+                    }
+                    _ => {}
+                })
+                .build(app)?;
+            app.manage(tray);
+            let (send, receive) = bounded(1);
+            let handle = app.handle().clone();
+            let state = Arc::clone(&setup_shared);
+            let join = thread::Builder::new()
+                .name("transport-acceptance-owner".into())
+                .spawn(move || owner(handle, state, item, receive, send))?;
+            *setup_worker
+                .lock()
+                .map_err(|_| "Adapterowner-Lock fehlerhaft")? = Some(join);
+            Ok(())
+        })
+        .build(context)?;
+    app.run(move |_, event| {
+        if let tauri::RunEvent::ExitRequested { api, .. } = event
+            && !shared.exit.request_quit()
+        {
+            api.prevent_exit();
+            shared.close();
+        }
+    });
+    // Native/hotkey cleanup completed before finished permits event-loop exit.
+    if let Some(join) = worker
+        .lock()
+        .map_err(|_| "Adapterowner-Lock fehlerhaft")?
+        .take()
+    {
+        join.join().map_err(|_| "Adapterowner panicked")?;
+    }
+    Ok(())
+}
