+//! Read-only actual bundle identity for the separate native acceptance adapter.
+use objc2::MainThreadMarker;
+use objc2_foundation::NSBundle;
+pub fn main_bundle_identifier() -> Result<Option<String>, &'static str> {
+    let _main = MainThreadMarker::new().ok_or("Bundle identity requires main thread")?;
+    Ok(NSBundle::mainBundle()
+        .bundleIdentifier()
+        .map(|value| value.to_string()))
+}
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn worker_rejects_before_appkit_bundle_access() -> Result<(), Box<dyn std::error::Error>> {
+        let result = std::thread::spawn(super::main_bundle_identifier)
+            .join()
+            .map_err(|_| "worker panicked")?;
+        assert!(result.is_err());
+        Ok(())
+    }
+}
