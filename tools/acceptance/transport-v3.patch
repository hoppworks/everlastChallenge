+//! One-shot admission for this separate adapter, never a recording state machine.
+#[derive(Default)]
+pub struct Gate {
+    ready: bool,
+    armed: bool,
+    busy: Option<u64>,
+    next: u64,
+    closed: bool,
+}
+impl Gate {
+    pub fn ready(&mut self) {
+        if !self.closed {
+            self.ready = true;
+        }
+    }
+    pub fn arm(&mut self) -> Result<(), &'static str> {
+        if self.closed || !self.ready || self.busy.is_some() {
+            return Err("Adapter nicht bereit oder noch belegt");
+        }
+        self.armed = true;
+        Ok(())
+    }
+    pub fn fire(&mut self) -> Result<Option<u64>, &'static str> {
+        if self.closed || !self.ready || !self.armed || self.busy.is_some() {
+            return Ok(None);
+        }
+        self.armed = false;
+        let id = self
+            .next
+            .checked_add(1)
+            .ok_or("Adapter-Sitzungsnummer erschöpft")?;
+        self.next = id;
+        self.busy = Some(id);
+        Ok(Some(id))
+    }
+    pub fn disarm(&mut self) {
+        self.armed = false;
+    }
+    pub fn complete(&mut self, id: u64) -> bool {
+        if self.busy == Some(id) {
+            self.busy = None;
+            true
+        } else {
+            false
+        }
+    }
+    pub fn close(&mut self) {
+        self.closed = true;
+        self.ready = false;
+        self.armed = false;
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn real_trigger_consumes_arm_once_and_owner_completion_is_required() -> Result<(), &'static str>
+    {
+        let mut g = Gate::default();
+        g.ready();
+        assert!(g.fire()?.is_none());
+        g.arm()?;
+        let id = g.fire()?.ok_or("trigger absent")?;
+        assert!(g.fire()?.is_none());
+        assert!(g.arm().is_err());
+        assert!(!g.complete(id + 1));
+        assert!(g.arm().is_err());
+        assert!(g.complete(id));
+        g.arm()?;
+        assert_eq!(g.fire()?, Some(id + 1));
+        Ok(())
+    }
+    #[test]
+    fn disarm_and_close_never_authorize_a_send_or_release_busy_owner() -> Result<(), &'static str> {
+        let mut g = Gate::default();
+        assert!(g.arm().is_err());
+        g.ready();
+        g.arm()?;
+        g.disarm();
+        assert!(g.fire()?.is_none());
+        g.arm()?;
+        let id = g.fire()?.ok_or("trigger absent")?;
+        g.disarm();
+        assert!(g.arm().is_err());
+        g.close();
+        assert!(g.complete(id));
+        g.ready();
+        assert!(g.arm().is_err());
+        Ok(())
+    }
+    #[test]
+    fn exhausted_session_identity_fails_closed() -> Result<(), &'static str> {
+        let mut g = Gate {
+            next: u64::MAX,
+            ..Gate::default()
+        };
+        g.ready();
+        g.arm()?;
+        assert!(g.fire().is_err());
+        Ok(())
+    }
+}
+
+/// One atomic modification order joins a UI Quit request with owner completion.
+#[derive(Default)]
+pub struct OwnerExit(std::sync::atomic::AtomicU8);
+impl OwnerExit {
+    pub fn request_quit(&self) -> bool {
+        self.0.fetch_or(1, std::sync::atomic::Ordering::AcqRel) & 2 != 0
+    }
+    pub fn finish(&self) -> bool {
+        self.0.fetch_or(2, std::sync::atomic::Ordering::AcqRel) & 1 != 0
+    }
+}
+#[cfg(test)]
+mod owner_exit_tests {
+    use super::OwnerExit;
+    #[test]
+    fn owner_finish_before_quit_allows_the_original_ui_exit() {
+        let exit = OwnerExit::default();
+        assert!(!exit.finish());
+        assert!(exit.request_quit());
+    }
+    #[test]
+    fn simultaneous_quit_and_owner_completion_cannot_both_miss() -> Result<(), &'static str> {
+        use std::sync::{Arc, Barrier};
+        for _ in 0..100 {
+            let exit = Arc::new(OwnerExit::default());
+            let barrier = Arc::new(Barrier::new(2));
+            let other = Arc::clone(&exit);
+            let ready = Arc::clone(&barrier);
+            let worker = std::thread::spawn(move || {
+                ready.wait();
+                other.finish()
+            });
+            barrier.wait();
+            let ui_exit = exit.request_quit();
+            let owner_exit = worker.join().map_err(|_| "owner test panicked")?;
+            assert_ne!(
+                ui_exit, owner_exit,
+                "one modification must observe the other"
+            );
+        }
+        Ok(())
+    }
+
+    #[test]
+    fn quit_during_registration_is_completed_on_startup_failure() {
+        let exit = OwnerExit::default();
+        assert!(!exit.request_quit());
+        assert!(
+            exit.finish(),
+            "the first pending Quit must exit after failed startup"
+        );
+    }
+}
