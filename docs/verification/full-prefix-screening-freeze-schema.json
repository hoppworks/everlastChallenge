{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:everlast:full-prefix-screening-freeze:v1",
  "title": "Prospective full-prefix pipeline/quality screen; NOT RUN / NOT QUALIFIED",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "screeningId",
    "sourceRevision",
    "binary",
    "selection",
    "manifest",
    "parameters",
    "sources",
    "launcher",
    "models",
    "inputs",
    "outputDirectory",
    "publisherPolicy",
    "caseTimeoutSeconds",
    "qualified",
    "L",
    "blocks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "prospective-full-prefix-screening-v1"
    },
    "screeningId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "binary": {
      "allOf": [
        {
          "$ref": "#/$defs/binding"
        },
        {
          "properties": {
            "path": {
              "const": "target/release/examples/paced_runtime_probe"
            }
          }
        }
      ]
    },
    "selection": {
      "allOf": [
        {
          "$ref": "#/$defs/binding"
        },
        {
          "properties": {
            "sha256": {
              "const": "864332ed3e11c4924066f920ff8c98e2c2c98f6040ddf0bff53ceff3b40551a9"
            }
          }
        }
      ]
    },
    "manifest": {
      "allOf": [
        {
          "$ref": "#/$defs/binding"
        },
        {
          "properties": {
            "sha256": {
              "const": "df432b44c48a39ebe290c6bd20d9ba8b800fd2211cdd898c86a9b22a54edf030"
            }
          }
        }
      ]
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "FullPrefixReference",
        "FullPrefixCandidate"
      ],
      "properties": {
        "FullPrefixCandidate": {
          "$ref": "#/$defs/binding"
        },
        "FullPrefixReference": {
          "$ref": "#/$defs/binding"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/binding"
      },
      "description": "Union of every compiled filename/hash plus both imported launch scripts, new script/test and this schema. Every extra source also current+immutable checked; no omitted compiled dependency accepted."
    },
    "launcher": {
      "$ref": "#/$defs/binding"
    },
    "models": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/binding"
      },
      "description": "Exact reference ASR and Silero VAD hashes/bytes, verified by preflight."
    },
    "inputs": {
      "type": "array",
      "minItems": 100,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "outputDirectory": {
      "type": "string",
      "pattern": "^artifacts/[^/]+(/[^/]+)*$",
      "maxLength": 4096,
      "description": "Fresh namespace with an existing parent. All1600 case targets are distinct, absent direct children. Freeze/launch/global completion targets are reserved."
    },
    "publisherPolicy": {
      "const": "timeConstrained"
    },
    "caseTimeoutSeconds": {
      "const": 7200,
      "description": "Owned process liveness deadline only, never an L acceptance threshold."
    },
    "qualified": {
      "const": false
    },
    "L": {
      "type": "null"
    },
    "blocks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "variant",
            "cases"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "variant": {
              "const": "FullPrefixReference"
            },
            "cases": {
              "type": "array",
              "minItems": 100,
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/caseCommand"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "variant",
            "cases"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "variant": {
              "const": "FullPrefixCandidate"
            },
            "cases": {
              "type": "array",
              "minItems": 100,
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/caseCommand"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "variant",
            "cases"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "variant": {
              "const": "FullPrefixCandidate"
            },
            "cases": {
              "type": "array",
              "minItems": 100,
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/caseCommand"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "variant",
            "cases"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "variant": {
              "const": "FullPrefixReference"
            },
            "cases": {
              "type": "array",
              "minItems": 100,
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/caseCommand"
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "required": [
        "path",
        "bytes",
        "sha256",
        "mode"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741824
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mode": {
          "type": "string",
          "pattern": "^0o[0-7]{3,4}$"
        }
      }
    },
    "caseCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "command",
        "output",
        "metadata",
        "log",
        "completion"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "command": {
          "type": "array",
          "minItems": 10,
          "maxItems": 11,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "output": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "metadata": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "log": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "completion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    }
  },
  "description": "A prospective descriptor, not an actual run or proof. Existing fixed100 selection and manifest remain unchanged: original90 and extra10 are never reweighted. Four ABBA blocks ×100 fresh processes ×(one marked warmup+one measured)=800 rows. No retry, resume, continuation, subset filtering or automatic quality/L qualification. Preflight validates all cross-file/cross-field conditions and exact compiled --print-full-prefix-reference-parameters/--print-full-prefix-candidate-parameters documents before model execution. Both arms use the same full reference Engine/model/config and scoped cache wrapper; only candidate activates cumulative prefix replacement. Independent Python trace proof requires increasing early0..cut with requiredcut+4800 reconstructed from completed afterPublish times; final0..N after AudioReleased; exact receipt IDs/hash/native origin with single-entry invalidation, ordered completion/adoption and post-join trace. Session RTF is measured decoder-call sum/uniqueN duration, not worker-span time or stop-to-text. Every failure/raw artifact and unavailable successor is retained. AC evidence is discrete initial/startup/before/after each case; no continuous AC/lid protection claim. Later canonical Unicode13.0 quality reports and full changed-text/anchor review are separate. Neither one warmup nor one measured run proves L/resource/P06 gates."
}
